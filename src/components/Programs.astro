---
const programs = [
  {
    title: 'Weight Training',
    description: 'Build raw strength and muscle with free weights, machines, and expert guidance.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'Cardio Zone',
    description: 'Treadmills, ellipticals, cycles, and more to get your heart pumping.',
    icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  },
  {
    title: 'Functional Training',
    description: 'Kettlebells, battle ropes, and bodyweight movements for real-world strength.',
    icon: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
  },
  {
    title: 'Personal Training',
    description: 'One-on-one coaching tailored to your body, goals, and schedule.',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  },
  {
    title: 'Group Classes',
    description: 'High-energy sessions that make working out feel like a party.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    title: 'Weight Loss',
    description: 'Structured programs combining training and nutrition guidance to drop fat.',
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  },
];
---

<section id="programs" class="section-padding bg-hype-charcoal">
  <div class="container-max">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="reveal text-hype-accent font-bold uppercase tracking-[0.2em] text-sm mb-3">
        What We Offer
      </p>
      <h2 class="reveal reveal-delay-1 heading-lg text-white mb-4">
        Programs for Every Goal
      </h2>
      <p class="reveal reveal-delay-2 text-white/50">
        Whether you want to lose weight, build muscle, or just feel better — we've got a program for you.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {programs.map((program, i) => (
        <div class={`reveal reveal-delay-${(i % 3) + 1} group bg-hype-black p-8 rounded-sm border border-white/5 hover:border-hype-accent/30 transition-all duration-300 hover:-translate-y-2`}>
          <div class="w-14 h-14 bg-hype-accent/10 rounded-sm flex items-center justify-center mb-6 group-hover:bg-hype-accent/20 transition-colors">
            <svg class="w-7 h-7 text-hype-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={program.icon} />
            </svg>
          </div>
          <h3 class="text-2xl text-white mb-3">{program.title}</h3>
          <p class="text-white/50 text-sm leading-relaxed">{program.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
