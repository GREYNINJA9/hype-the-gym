---
// Replace with real gym photos from Google Maps listing
const images = [
  { src: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=800&q=80', alt: 'Gym floor with equipment' },
  { src: 'https://images.unsplash.com/photo-1571902943202-507ec2618e8f?w=800&q=80', alt: 'Members training' },
  { src: 'https://images.unsplash.com/photo-1540497077202-7c8a3999166f?w=800&q=80', alt: 'Weight training area' },
  { src: 'https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=800&q=80', alt: 'Cardio section' },
  { src: 'https://images.unsplash.com/photo-1593079831268-3381b0db4a77?w=800&q=80', alt: 'Functional training' },
  { src: 'https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?w=800&q=80', alt: 'Personal training session' },
];
---

<section id="gallery" class="section-padding bg-hype-charcoal">
  <div class="container-max">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="reveal text-hype-accent font-bold uppercase tracking-[0.2em] text-sm mb-3">
        Gallery
      </p>
      <h2 class="reveal reveal-delay-1 heading-lg text-white mb-4">
        Inside Hype The Gym
      </h2>
      <p class="reveal reveal-delay-2 text-white/50">
        Take a look at where the magic happens.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {images.map((img, i) => (
        <button
          class={`reveal reveal-delay-${(i % 3) + 1} gallery-item group relative overflow-hidden rounded-sm cursor-pointer`}
          data-src={img.src}
          data-alt={img.alt}
        >
          <img
            src={img.src}
            alt={img.alt}
            class="w-full aspect-square object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors duration-300 flex items-center justify-center">
            <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
            </svg>
          </div>
        </button>
      ))}
    </div>

    <p class="text-center text-white/30 text-xl font-bold mt-8 reveal">
      Where strength meets focus. Heavy-duty free weights and racks ready for every lift.
    </p>
  </div>
</section>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center p-4">
  <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white p-2" aria-label="Close lightbox">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[85vh] object-contain rounded-sm" />
</div>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxClose = document.getElementById('lightbox-close');

  document.querySelectorAll('.gallery-item').forEach((item) => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src');
      const alt = item.getAttribute('data-alt');
      if (lightboxImg && lightbox) {
        lightboxImg.src = src || '';
        lightboxImg.alt = alt || '';
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const closeLightbox = () => {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
    document.body.style.overflow = '';
  };

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
