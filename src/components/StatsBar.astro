---
// These are placeholder/editable values. Replace with verified data from Google Maps.
const stats = [
  { value: '4.8', label: 'Google Rating', suffix: '★' },
  { value: '1,686', label: 'Reviews', suffix: '+' },
  { value: '8', label: 'Years Experience', suffix: '+' },
  { value: '500', label: 'Active Members', suffix: '+' },
  { value: '6', label: 'Expert Trainers', suffix: '' },
];
---

<section class="bg-hype-accent">
  <div class="container-max px-4 sm:px-6 lg:px-8 py-8 md:py-10">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-6 md:gap-4">
      {stats.map((stat, i) => (
        <div class={`reveal reveal-delay-${i + 1} text-center`}>
          <div class="text-3xl md:text-4xl font-heading text-black">
            {stat.value}<span class="text-xl">{stat.suffix}</span>
          </div>
          <div class="text-xs md:text-sm font-bold uppercase tracking-wider text-black/70 mt-1">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
