---
const phone = '9555200004';
const phoneClean = phone.replace(/^0/, '');
const whatsappLink = `https://wa.me/91${phoneClean}?text=Hi%20Hype%20The%20Gym!%20I%20want%20to%20enquire%20about%20membership.`;
---

<section id="contact" class="section-padding bg-hype-black">
  <div class="container-max">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Form -->
      <div>
        <p class="reveal text-hype-accent font-bold uppercase tracking-[0.2em] text-sm mb-3">
          Get In Touch
        </p>
        <h2 class="reveal reveal-delay-1 heading-lg text-white mb-4">
          Start Your Fitness Journey
        </h2>
        <p class="reveal reveal-delay-2 text-white/50 mb-8">
          Fill out the form and we'll get back to you within 24 hours. Or just give us a call — we're happy to help.
        </p>

        <form id="contact-form" class="space-y-5 reveal reveal-delay-3">
          <div>
            <label for="name" class="block text-sm font-semibold text-white/70 mb-2">Full Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full bg-hype-charcoal border border-white/10 rounded-sm px-4 py-3 text-white placeholder-white/30 focus:border-hype-accent focus:outline-none transition-colors"
              placeholder="Your name"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-semibold text-white/70 mb-2">Phone Number *</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="w-full bg-hype-charcoal border border-white/10 rounded-sm px-4 py-3 text-white placeholder-white/30 focus:border-hype-accent focus:outline-none transition-colors"
              placeholder="Your phone number"
            />
          </div>

          <div>
            <label for="goal" class="block text-sm font-semibold text-white/70 mb-2">Your Goal</label>
            <select
              id="goal"
              name="goal"
              class="w-full bg-hype-charcoal border border-white/10 rounded-sm px-4 py-3 text-white focus:border-hype-accent focus:outline-none transition-colors"
            >
              <option value="">Select a goal</option>
              <option value="weight-loss">Weight Loss</option>
              <option value="muscle-gain">Muscle Gain</option>
              <option value="general-fitness">General Fitness</option>
              <option value="personal-training">Personal Training</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-white/70 mb-2">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full bg-hype-charcoal border border-white/10 rounded-sm px-4 py-3 text-white placeholder-white/30 focus:border-hype-accent focus:outline-none transition-colors resize-none"
              placeholder="Tell us about your fitness goals..."
            ></textarea>
          </div>

          <!-- Honeypot -->
          <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

          <button type="submit" class="btn-primary w-full text-base">
            Send Enquiry
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </button>

          <div id="form-status" class="hidden text-center p-4 rounded-sm text-sm"></div>
        </form>
      </div>

      <!-- Contact Info + Map -->
      <div class="reveal reveal-delay-2">
        <!-- Info Cards -->
        <div class="space-y-4 mb-8">
          <a href={`tel:+91${phoneClean}`} class="flex items-start gap-4 bg-hype-charcoal p-5 rounded-sm border border-white/5 hover:border-hype-accent/30 transition-colors group">
            <div class="w-10 h-10 bg-hype-accent/10 rounded-sm flex items-center justify-center flex-shrink-0 group-hover:bg-hype-accent/20 transition-colors">
              <svg class="w-5 h-5 text-hype-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-sm text-white/50">Call Us</div>
              <div class="text-white font-semibold">{phone}</div>
            </div>
          </a>

          <div class="flex items-start gap-4 bg-hype-charcoal p-5 rounded-sm border border-white/5">
            <div class="w-10 h-10 bg-hype-accent/10 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-hype-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-sm text-white/50">Address</div>
              <div class="text-white font-semibold text-sm leading-relaxed">
                Sector 28, Main Hudda Market SCO 100,<br />
                Faridabad, Haryana 121008
              </div>
            </div>
          </div>

          <div class="flex items-start gap-4 bg-hype-charcoal p-5 rounded-sm border border-white/5">
            <div class="w-10 h-10 bg-hype-accent/10 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-hype-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="text-sm text-white/50">Opening Hours</div>
              <div class="text-white font-semibold text-sm">
                Mon–Sat: 6:00 AM – 10:00 PM<br />
                Sunday: 2:00 PM – 9:00 PM
              </div>
            </div>
          </div>
        </div>

        <!-- WhatsApp CTA -->
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-3 w-full bg-[#25D366] text-white font-bold uppercase tracking-wider py-4 rounded-sm hover:bg-[#20BD5A] transition-colors mb-8"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          Chat on WhatsApp
        </a>

        <!-- Google Map -->
        <div class="rounded-sm overflow-hidden border border-white/10">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3510.5!2d77.3147693!3d28.4347427!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390cdd321579cd35%3A0x87fcbb297609f395!2sHype%20The%20Gym%20-%2028%20sector%20Faridabad!5e0!3m2!1sen!2sin!4v1"
            width="100%"
            height="300"
            style="border:0; filter: grayscale(100%) invert(92%) contrast(83%);"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Hype The Gym location on Google Maps"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.innerHTML;

    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Sending...';

    try {
      const formData = new FormData(form);
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: formData,
      });

      const data = await res.json();

      if (res.ok) {
        status!.className = 'text-center p-4 rounded-sm text-sm bg-hype-accent/10 text-hype-accent border border-hype-accent/30';
        status!.textContent = 'Thank you! We will contact you shortly.';
        form.reset();
      } else {
        throw new Error(data.message || 'Something went wrong.');
      }
    } catch (err) {
      status!.className = 'text-center p-4 rounded-sm text-sm bg-red-500/10 text-red-400 border border-red-500/30';
      status!.textContent = 'Sorry, there was an error. Please call us directly.';
    } finally {
      status!.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    }
  });
</script>
