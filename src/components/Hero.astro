---
const phone = '9555200004';
const whatsappLink = `https://wa.me/91${phone.replace(/^0/, '')}?text=Hi%20Hype%20The%20Gym!%20I%20want%20to%20book%20a%20free%20trial.`;
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1920&q=80"
      alt="Hype The Gym interior with modern equipment"
      class="w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-hype-black via-hype-black/80 to-hype-black/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-hype-black via-transparent to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container-max px-4 sm:px-6 lg:px-8 pt-24 pb-16">
    <div class="max-w-3xl">
      <p class="reveal text-hype-accent font-bold uppercase tracking-[0.3em] text-sm mb-4">
        Sector 28, Faridabad
      </p>
      <h1 class="reveal reveal-delay-1 heading-xl text-white mb-6">
        Build Your
        <span class="text-hype-accent block">Strongest Self</span>
        at Hype The Gym
      </h1>
      <p class="reveal reveal-delay-2 text-lg sm:text-xl text-white/70 max-w-xl mb-10 leading-relaxed">
        No shortcuts. No excuses. Just real training, real results, and a community that pushes you to be better every single day.
      </p>

      <div class="reveal reveal-delay-3 flex flex-col sm:flex-row gap-4">
        <a href="#contact" class="btn-primary text-base">
          Book a Free Trial
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href={`tel:+91${phone}`} class="btn-outline text-base">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call Now
        </a>
      </div>

      <!-- Quick badges -->
      <div class="reveal reveal-delay-4 flex flex-wrap gap-6 mt-12 text-sm text-white/50">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-hype-accent rounded-full"></span>
          Open Mon–Sat 6 AM–10 PM
        </span>
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-hype-accent rounded-full"></span>
          Sunday 2 PM–9 PM
        </span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce hidden md:block">
    <svg class="w-6 h-6 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
