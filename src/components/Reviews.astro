---
// Based on real customer feedback themes from the Google Maps listing.
// Replace with actual review text and reviewer names.
const reviews = [
  {
    name: 'Shivamshakya Official',
    rating: 5,
    text: "joined this gym one month ago, and my experience so far has been really good. The gym environment is motivating, clean, and comfortable. All the trainers are supportive, friendly, and professional, which really helps beginners like me feel confident. I am personally trained by Rohit sir, who is very patient, dedicated, and encouraging. He guides me properly during workouts, corrects my form, and motivates me to stay consistent. Right now, I am focusing on building a routine, discipline, and learning exercises correctly, and this gym has been a great place for that. I feel encouraged to continue my fitness journey here. Highly recommended for beginners who want proper guidance and a positive environment. b'it",
    date: '8 months ago',
  },
  {
    name: 'Shoaib Saifi',
    rating: 5,
    text: 'Nice Place for workout The Hype Gym yes yes yes The gym is very Best place with better hygenic and good cleaning space available for workout with best trainer ex- Sunil sir the very genuine trainer in this gym . And proper guidance availble with very cooperative staff the manager Vivek is very helpful for every one✌️ join this Gym u get better results in less time periode ♥️',
    date: '2 years ago',
  },
  {
    name: 'Puneet Parashar',
    rating: 5,
    text: "Best gym in Faridabad. It\'s located in Sector 28, market of faridabad, Haryana. Good machines, spacious and healthy environment to workout. Coaches and spotters are always there to help and support💪💪 …",
    date: 'a year ago',
  },
  {
    name: 'priyanka advani',
    rating: 5,
    text: 'The gym is nice and has almost all the equipment and also all the facilities .. very close to my place so very comfortable and also very clean when it comes to maintaining hygiene. The trainer are also super supportive especially Sunil sir. He has customized  special diet plans and excercise chart also for everyday and also helps us out if get stuck anywhere during the sessions. Thank you Hype the gym Sector 28 Faridabad',
    date: '9 months ago',
  },
];
---

<section id="reviews" class="section-padding bg-hype-black">
  <div class="container-max">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="reveal text-hype-accent font-bold uppercase tracking-[0.2em] text-sm mb-3">
        Testimonials
      </p>
      <h2 class="reveal reveal-delay-1 heading-lg text-white mb-4">
        What Our Members Say
      </h2>
      <div class="reveal reveal-delay-2 flex items-center justify-center gap-2 mb-4">
        <div class="flex text-hype-accent">
          {[1, 2, 3, 4, 5].map((star) => (
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-white/50 text-sm">4.8 from Google Reviews</span>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {reviews.map((review, i) => (
        <div class={`reveal reveal-delay-${(i % 2) + 1} bg-hype-charcoal p-6 sm:p-8 rounded-sm border border-white/5`}>
          <div class="flex text-hype-accent mb-4">
            {Array.from({ length: 5 }).map((_, j) => (
              <svg class={`w-4 h-4 ${j < review.rating ? 'text-hype-accent' : 'text-white/20'}`} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-white/70 leading-relaxed mb-4">"{review.text}"</p>
          <div class="flex items-center justify-between">
            <span class="text-white font-semibold text-sm">{review.name}</span>
            <span class="text-white/30 text-xs">{review.date}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12 reveal">
      <a
        href="https://www.google.com/maps/place/Hype+The+Gym+-+28+sector+Faridabad/@28.4347427,77.3147693,16z"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline text-sm"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
        </svg>
        Review us on Google
      </a>
    </div>

    <p class="text-center text-white/30 text-xl mt-6 reveal">
      We are thrilled to hear you’re enjoying the new strength equipment. Keep crushing your goals!
    </p>
  </div>
</section>
